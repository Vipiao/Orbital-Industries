{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OrbitalIndustries",
            "type": "cppdbg",
            "request": "launch",
            //"program": "${workspaceFolder}/bin/OrbitalIndustries.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            //"miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "windows": {
                "program": "${workspaceFolder}/bin/OrbitalIndustries.exe",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
            },
            "linux": {
                "program": "${workspaceFolder}/bin/OrbitalIndustries",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip GLM files",
                    "text": "skip -gfi */glm/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip MinGW standard library",
                    "text": "skip -gfi */mingw64/*",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip C++ standard library",
                    "text": "skip -gfi */include/c++/*",
                    "ignoreFailures": true
                }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/natvis/glm.natvis",
            //"showDisplayString": true,
            "preLaunchTask": "CMake: build",  // This uses CMake extension's task
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            }
        }
    ]
}